# --- Podcast
podcast.codetri.net {
	redir https://creators.spotify.com/pod/profile/cely717/ 303
}

# -- Notes
blog.codetri.net {
	# Don't reveal server info
	header -server

	# Compress files on the fly
	encode gzip zstd

	# Define the server root
	root * /var/www/notes/dist

	# Make the index loadable (don't ask why this is needed, it just is)
	rewrite / index

	# Serve the site
	try_files {path}.html {path} =404
	file_server

	handle_errors 404 {
		# respond  404.html
		# "It's a 404 error!"
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/ct-notes.log
		format json
	}
}
